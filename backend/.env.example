# Copia este archivo como ".env" (sin .example) y completa los valores. ".env" NUNCA se sube a Git.

# Cadena de conexión de Neon (botón "Connect" del proyecto). Para la API usa la versión POOLED (con "-pooler").
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Solo para scripts de migración/seed desde tu computador: la versión SIN "-pooler".
DATABASE_URL_DIRECT="postgresql://USUARIO:CLAVE@ep-xxxxxxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Firma de los tokens de sesión. Genera uno largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio"
JWT_EXPIRES_IN="2h"

# Dominio del frontend permitido por CORS
FRONTEND_ORIGIN="http://localhost:5500"
PORT=3000
