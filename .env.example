# Copia este archivo como .env y pon tu cadena de Neon. NUNCA subas .env a Git.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST.neon.tech/neondb?sslmode=require
PORT=3000

# --- Opcionales (valores por defecto entre paréntesis) ---
# TRAFFIC_C=100              capacidad máxima simulada de conexiones
# TRAFFIC_K=200              constante de procesamiento k
# TRAFFIC_TB=120             tiempo de respuesta base Tb (ms)
# TRAFFIC_DT_CRITICAL=0.5    umbral crítico de T'(x) que activa la Fila Virtual
# TRAFFIC_SIM=off            desactiva el simulador de carga (úsalo en producción)
# DYNPRICE_JOB=off           apaga la revisión automática de precios dinámicos (cada 60 s)
# DYNPRICE_MIN_RATE=150000   tasa mínima de ventas (COP/hora) para considerar un pico
# DYNPRICE_COOLDOWN_MIN=60   minutos mínimos entre dos ajustes de precio del mismo evento
